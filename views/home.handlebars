<main class="page">

  <header class="masthead rise">
    <span class="avatar">
      <img src="{{site.avatar.src}}" alt="{{site.avatar.alt}}" width="92" height="92" />
    </span>
    <div class="masthead-text">
      <h1 class="name">{{site.name}}</h1>
      {{#if site.role}}
        <p class="role">
          {{#each site.role}}{{#if @first}}<span class="role-part">{{this}}</span>{{else}} <span class="role-part"><span class="sep">//</span>{{this}}</span>{{/if}}{{/each}}
        </p>
      {{/if}}
    </div>
  </header>

  <hr class="rule rise" />

  <section class="rise">
    {{#if site.lead}}<p class="lead">{{{site.lead}}}</p>{{/if}}
    {{#if site.aside}}<p class="aside">{{{site.aside}}}</p>{{/if}}
    {{#if site.body}}
      <div class="prose">
        {{#each site.body}}<p>{{{this}}}</p>{{/each}}
      </div>
    {{/if}}
  </section>

  {{#if site.focus}}
    <hr class="rule rise" />

    <section class="rise">
      <h2 class="label">{{site.focus.label}}</h2>
      <ul class="grid">
        {{#each site.focus.items}}
          <li>
            <h3><span class="num">{{ordinal @index}}</span>{{this.title}}</h3>
            <p>{{{this.body}}}</p>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <hr class="rule rise" />

  <section class="rise">
    <div class="actions">
      {{#if site.email}}
        <a class="btn" href="mailto:{{site.email.address}}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4.5" width="20" height="15" rx="2" />
            <path d="m2.5 6 9.5 6.5L21.5 6" />
          </svg>
          {{site.email.label}}
        </a>
      {{/if}}
      {{#each site.links}}
        <a class="link" href="{{this.href}}"{{#if this.external}} target="_blank" rel="noopener noreferrer"{{/if}}>
          {{this.label}}{{#if this.external}}<span class="arrow" aria-hidden="true">↗</span>{{/if}}
        </a>
      {{/each}}
    </div>

    {{#if site.colophon}}
      <p class="colophon">
        {{#each site.colophon.items}}
          {{#unless @first}}<span class="dot" aria-hidden="true">·</span>{{/unless}}<span>{{this}}</span>
        {{/each}}
        {{#if site.colophon.clock}}
          <span class="dot" aria-hidden="true">·</span>
          <span class="clock" data-timezone="{{site.colophon.clock.timeZone}}"
            data-label="{{site.colophon.clock.label}}" hidden></span>
        {{/if}}
      </p>
    {{/if}}
  </section>

</main>

{{#if site.colophon.clock}}
  <script>
    (function () {
      var el = document.querySelector('.clock');
      if (!el) return;
      var tz = el.dataset.timezone;
      var label = el.dataset.label;

      function tick() {
        try {
          var time = new Intl.DateTimeFormat('en-GB', {
            timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false,
          }).format(new Date());
          el.textContent = label ? label + ' ' + time : time;
          el.hidden = false;
        } catch (e) {
          el.remove();
          return;
        }
        setTimeout(tick, 30000);
      }

      tick();
    })();
  </script>
{{/if}}
